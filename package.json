{
  "name": "gitargo-root",
  "version": "0.6.4",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run start:api\" \"npm run start:ui\"",
    "start:api": "cd services/api && npm install && node server.js",
    "start:ui": "cd services/ui && PORT=3001 npm start",
    "install:all": "cd services/api && npm install && cd ../ui && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "shell-quote": "^1.8.3",
    "qs": "^6.16.1",
    "ip-address": "^10.7.4",
    "minimatch": "^11.0.1",
    "brace-expansion": "^5.0.12",
    "glob": "^14.0.2"
  }
}
