# GitLab Configuration
# Required for persisting and retrieving workflow templates
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_personal_access_token
GITLAB_PROJECT_ID=your_project_id
GITLAB_BRANCH=main
GITLAB_WORKFLOWS_PATH=.

# Application Configuration
PORT=3000
BASE_PATH=
ALLOW_PUBLISHING=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Log Viewer (Loki) Configuration
# LOKI_URL=http://loki:3100
# LOKI_NAMESPACE_LABEL=namespace
# ARGO_WORKFLOW_LABEL=workflows_argoproj_io_workflow
# LOG_VIEWER_URL=https://logviewer.domain.com/search

# Argo & Kubernetes Configuration
ARGO_NAMESPACE=default
ARGO_SERVICE_ACCOUNT=default

# Authentication:
# 1. ARGO_AUTH_TOKEN (if set)
# 2. Service Account Token (read from /var/run/secrets/kubernetes.io/serviceaccount/token)
# 3. User session token (passed through from the incoming request)
# ARGO_AUTH_TOKEN=your_static_token_here

# Preconfigured Resource Profiles (JupyterHub kubespawner_override JSON string)
ARGO_PROFILES='{"small": {"display_name": "Small (4 GB RAM, 1 CPU)", "kubespawner_override": {"mem_guarantee": "3.6G", "mem_limit": "4G", "cpu_guarantee": 0.5, "cpu_limit": 1}}, "gpu": {"display_name": "12 GB RAM, 3 CPUs, 1 GPU", "kubespawner_override": {"mem_guarantee": "10.8G", "mem_limit": "12G", "cpu_guarantee": 1.5, "cpu_limit": 3, "extra_resource_limits": {"nvidia.com/gpu": "1"}, "node_selector": {"cce.cloud.com/cce-nodepool": "userg"}, "tolerations": [{"key": "hub.jupyter.org/dedicated", "operator": "Equal", "value": "user", "effect": "NoSchedule"}]}}}'
# Global S3 Artifact Repository Configuration
# Used as a fallback if the workflow artifact does not specify credentials directly.
# Using standard AWS SDK environment variable names is supported.
# AWS_ENDPOINT_URL=https://obs.eu-nl.otc.t-systems.com
# BUCKET_NAME=my-argo-bucket
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=eu-nl
